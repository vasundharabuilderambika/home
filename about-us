<style>
:root{
  --green:#071f19;
  --green2:#103a2d;
  --gold:#d9b46b;
  --gold-light:#f3dfa9;
  --cream:#f7f4ec;
  --white:#fffdf8;
  --ink:#26342e;
  --muted:#68746c;
  --line:rgba(217,180,107,.35);
  --serif:'Playfair Display',serif;
  --sans:'Montserrat',sans-serif;
  --ease:cubic-bezier(.22,.68,0,1.05);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:82px}
body{
  margin:0;background:var(--cream);color:var(--ink);
  font-family:var(--sans);line-height:1.75;overflow-x:hidden
}
body.menu-open{overflow:hidden}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%}
button{font:inherit}
h1,h2,h3{font-family:var(--serif);font-weight:500;line-height:1.25}
p{margin:0 0 18px}
section{position:relative}
.container{width:min(1160px,calc(100% - 44px));margin:auto}
.section{padding:100px 0}
.kicker{
  display:flex;align-items:center;gap:13px;
  color:#a47c36;text-transform:uppercase;letter-spacing:2.5px;
  font-size:10px;font-weight:700;margin-bottom:18px
}
.kicker:before{content:"";width:28px;height:1px;background:currentColor}
.kicker.center{justify-content:center}
.kicker.center:after{content:"";width:28px;height:1px;background:currentColor}
.section-title{font-size:clamp(31px,4.2vw,49px);margin:0 0 20px}
.gold-text{color:#b98c42}
.section-intro{max-width:650px;color:var(--muted);font-size:14px}
.section-head{text-align:center;max-width:750px;margin:0 auto 55px}
.section-head .section-intro{margin:auto}
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:10px;
  padding:14px 22px;border:1px solid var(--gold);border-radius:3px;
  text-transform:uppercase;letter-spacing:1px;font-size:10px;font-weight:700;
  transition:transform .3s,box-shadow .3s,background .3s
}
.btn-gold{background:linear-gradient(120deg,var(--gold-light),var(--gold));color:var(--green)}
.btn-outline{color:white;background:#ffffff08}
.btn-dark{background:var(--green);color:white}
.btn:hover{transform:translateY(-3px);box-shadow:0 12px 26px #0002}
:focus-visible{outline:3px solid var(--gold);outline-offset:4px}

/* HEADER */
.header{
  position:fixed;top:0;left:0;right:0;z-index:1000;
  color:white;background:rgba(5,27,21,.9);
  border-bottom:1px solid #d9b46b30;
  backdrop-filter:blur(18px);transition:background .3s,box-shadow .3s
}
.header.scrolled{background:rgba(5,27,21,.98);box-shadow:0 8px 25px #0002}
.nav{min-height:78px;display:flex;align-items:center;justify-content:space-between;gap:24px}
.logo{display:flex;align-items:center;gap:12px;min-width:0}
.logo-symbol{
  width:43px;height:43px;border:1px solid var(--gold);border-radius:50%;
  display:grid;place-items:center;color:var(--gold);
  font-family:var(--serif);font-size:23px
}
.logo-name{font-family:var(--serif);font-size:17px;letter-spacing:1px;line-height:1.3}
.logo-sub{font-size:8px;letter-spacing:3px;color:var(--gold);text-align:center}
.nav-links{display:flex;align-items:center;gap:22px}
.nav-links a{
  position:relative;font-size:10px;text-transform:uppercase;
  letter-spacing:1px;color:#e5e9e5;transition:color .25s
}
.nav-links a:not(.btn):after{
  content:"";position:absolute;left:0;bottom:-8px;width:0;height:1px;
  background:var(--gold);transition:width .3s
}
.nav-links a:hover,.nav-links a.active{color:var(--gold-light)}
.nav-links a:hover:after,.nav-links a.active:after{width:100%}
.nav-links .btn{padding:11px 15px;font-size:9px}
.menu-toggle{
  display:none;border:1px solid var(--line);border-radius:3px;
  padding:7px 12px;color:var(--gold);background:transparent;font-size:22px
}

/* HERO */
.hero{
  min-height:590px;display:flex;align-items:center;position:relative;
  color:white;overflow:hidden;
  background:
   linear-gradient(90deg,rgba(3,25,19,.91),rgba(3,25,19,.68) 46%,rgba(3,25,19,.2)),
   url('https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=2200&q=85') center/cover;
}
.hero:after{
  content:"";position:absolute;inset:auto 0 0;height:90px;
  background:linear-gradient(transparent,var(--green))
}
.hero-content{position:relative;z-index:1;padding:155px 0 110px;max-width:760px}
.hero .kicker{color:var(--gold-light);animation:fadeUp .8s .1s both}
.hero h1{
  font-size:clamp(42px,7vw,79px);letter-spacing:-1px;
  margin:0 0 24px;line-height:1.1;animation:fadeUp .9s .25s both
}
.hero h1 span{display:block;color:var(--gold-light);font-style:italic}
.hero-copy{max-width:570px;color:#e1e8e2;font-size:14px;animation:fadeUp .9s .4s both}
.hero-actions{display:flex;flex-wrap:wrap;gap:13px;margin-top:30px;animation:fadeUp .9s .55s both}
.hero-stamp{
  position:absolute;z-index:2;right:5%;bottom:58px;
  border:1px solid #d9b46b9c;background:#09271fe8;
  padding:16px 21px;color:var(--gold-light);font-size:10px;letter-spacing:1px
}
.hero-stamp strong{display:block;color:white;font:17px var(--serif)}

/* STORY */
.story{background:var(--cream)}
.story-grid{display:grid;grid-template-columns:1fr 1fr;gap:75px;align-items:center}
.story-copy .section-title{color:var(--green)}
.story-copy p{font-size:14px;color:#626d66}
.story-photo{position:relative;padding:0 0 24px 24px}
.story-photo:before{
  content:"";position:absolute;left:0;bottom:0;width:65%;height:68%;
  background:var(--gold);opacity:.28
}
.story-photo img{
  position:relative;width:100%;height:470px;object-fit:cover;
  border-radius:3px;box-shadow:0 20px 50px #13291d1c;
  transition:transform .6s
}
.story-photo:hover img{transform:translateY(-5px)}
.photo-note{
  position:absolute;right:-15px;bottom:45px;background:var(--green);
  color:white;padding:20px 24px;border-left:3px solid var(--gold);
  box-shadow:0 12px 30px #0002
}
.photo-note strong{display:block;color:var(--gold-light);font:18px var(--serif)}
.photo-note span{font-size:10px;color:#c8d5cc}

/* VALUES STRIP */
.values{background:var(--green);border-block:1px solid var(--line);color:white}
.values-grid{display:grid;grid-template-columns:repeat(3,1fr);padding:40px 0}
.value{text-align:center;padding:5px 28px;border-right:1px solid #ffffff20}
.value:last-child{border:0}
.value-icon{color:var(--gold);font-size:27px;margin-bottom:8px}
.value h3{font-size:18px;margin:0 0 8px}
.value p{font-size:11px;color:#b9c8be;margin:0}

/* STATS */
.stats{background:var(--white);padding:48px 0}
.stats-grid{display:grid;grid-template-columns:repeat(3,1fr)}
.stat{text-align:center;padding:10px;border-right:1px solid #e8dfce}
.stat:last-child{border:0}
.stat h3{color:#b58b45;font-size:clamp(34px,5vw,51px);margin:0 0 3px}
.stat p{color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:1.5px;margin:0}

/* MISSION & VISION */
.mission{background:#fff;padding:95px 0}
.mv-grid{display:grid;grid-template-columns:1fr 1fr;gap:25px}
.mv-card{
  position:relative;padding:43px 38px;background:var(--cream);
  border:1px solid #e9dfcc;border-top:3px solid var(--gold);
  transition:transform .35s,box-shadow .35s
}
.mv-card:hover{transform:translateY(-7px);box-shadow:0 18px 40px #0a261510}
.mv-index{font:44px var(--serif);color:#d5b16b55;line-height:1}
.mv-card h3{font-size:27px;color:var(--green);margin:12px 0}
.mv-card p{font-size:13px;color:var(--muted);margin:0}

/* LEADERSHIP */
.leadership{
  padding:100px 0;color:white;
  background:radial-gradient(ellipse at top,#123a2c 0%,#071f19 66%);
  overflow:hidden
}
.leadership:before{
  content:"";position:absolute;inset:0;opacity:.08;
  background:url('https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1800&q=80') center/cover
}
.leadership .container{position:relative}
.leadership .section-head .section-intro{color:#b9c9bf}
.leadership .kicker{color:var(--gold)}
.leadership .section-title{color:white}
.leadership-label{
  text-align:center;color:var(--gold-light);font-size:10px;
  font-weight:700;letter-spacing:2.5px;margin:38px 0 25px
}
.leader-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px;max-width:900px;margin:auto}
.leader-card{
  position:relative;display:flex;align-items:center;gap:22px;
  min-width:0;padding:25px;background:#ffffff06;
  border:1px solid #d9b46b4c;border-radius:5px;
  transition:transform .35s,border-color .35s,background .35s
}
.leader-card:hover{transform:translateY(-6px);border-color:var(--gold);background:#ffffff0d}
.leader-img{
  width:112px;height:112px;flex:0 0 112px;object-fit:cover;
  object-position:center top;border-radius:50%;padding:4px;
  border:1px solid #d9b46b80;background:#ffffff08;
  transition:transform .45s,border-color .3s
}
.leader-card:hover .leader-img{transform:scale(1.045);border-color:var(--gold)}
.leader-info{min-width:0}
.leader-role{color:var(--gold-light);font-size:9px;letter-spacing:1.4px;font-weight:700}
.leader-card h3{font-size:19px;margin:8px 0;overflow-wrap:anywhere}
.leader-card p{font-size:11px;color:#bdcdc2;margin:0}
.leadership-footnote{text-align:center;color:#94aca0;font-size:10px;margin-top:24px}

/* CONTACT CTA */
.cta{background:linear-gradient(120deg,#e8cf94,#f7e9c4);padding:48px 0}
.cta-inner{display:flex;justify-content:space-between;align-items:center;gap:25px}
.cta h2{font-size:clamp(26px,4vw,39px);margin:0 0 8px;color:var(--green)}
.cta p{font-size:12px;color:#596459;margin:0}

/* FOOTER */
.footer{background:#041710;color:#c6d1c9;padding:58px 0 22px}
.footer-main{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:45px;padding-bottom:38px}
.footer-about p{max-width:350px;color:#9eb0a4;font-size:12px;margin-top:17px}
.footer h3{font:17px var(--serif);color:var(--gold-light);margin:5px 0 17px}
.footer-links{display:grid;gap:10px}
.footer-links a{font-size:11px;color:#aabbb0;transition:color .2s}
.footer-links a:hover{color:var(--gold)}
.footer-socials{display:flex;gap:9px;margin-top:17px}
.footer-socials a{
  width:32px;height:32px;display:grid;place-items:center;
  border:1px solid #d9b46b65;border-radius:50%;color:var(--gold-light);font-size:11px
}
.copyright{
  border-top:1px solid #ffffff15;padding-top:20px;
  display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;
  color:#82958a;font-size:10px
}
.back-top{
  position:fixed;right:20px;bottom:20px;z-index:900;
  width:43px;height:43px;border:1px solid var(--gold);
  background:var(--green);color:var(--gold-light);border-radius:50%;
  cursor:pointer;opacity:0;pointer-events:none;transform:translateY(10px);
  transition:.3s
}
.back-top.visible{opacity:1;pointer-events:auto;transform:translateY(0)}

/* ANIMATION */
.reveal{opacity:0;transform:translateY(30px);transition:opacity .8s ease,transform .8s var(--ease)}
.reveal.from-left{transform:translateX(-35px)}
.reveal.from-right{transform:translateX(35px)}
.reveal.visible{opacity:1;transform:translate(0,0)}
@keyframes fadeUp{
  from{opacity:0;transform:translateY(24px)}
  to{opacity:1;transform:translateY(0)}
}
@media(prefers-reduced-motion:reduce){
  *,*:before,*:after{scroll-behavior:auto!important;animation:none!important;transition:none!important}
  .reveal{opacity:1;transform:none}
}

/* RESPONSIVE */
@media(max-width:1050px){
  .nav-links{gap:13px}
  .nav-links a{font-size:9px}
  .story-grid{gap:42px}
  .leader-card{padding:19px;gap:16px}
  .leader-img{width:90px;height:90px;flex-basis:90px}
}
@media(max-width:780px){
  .container{width:calc(100% - 34px)}
  .section{padding:70px 0}
  .nav{min-height:70px}
  .logo-name{font-size:15px}
  .logo-symbol{width:38px;height:38px}
  .menu-toggle{display:block}
  .nav-links{
    display:none;position:fixed;top:70px;left:0;right:0;bottom:0;
    overflow-y:auto;padding:20px 25px;background:#061f18;
    flex-direction:column;align-items:stretch;gap:0
  }
  .nav-links.open{display:flex}
  .nav-links a:not(.btn){padding:15px 3px;border-bottom:1px solid #ffffff15;font-size:12px}
  .nav-links .btn{margin-top:22px;align-self:flex-start}
  .hero{min-height:560px;background-position:58% center}
  .hero-content{padding:135px 0 100px}
  .hero h1{font-size:clamp(40px,9vw,62px)}
  .hero-stamp{display:none}
  .story-grid{grid-template-columns:1fr;gap:45px}
  .story-photo{margin-right:12px}
  .story-photo img{height:350px}
  .photo-note{right:-12px;bottom:35px}
  .mv-grid{grid-template-columns:1fr}
  .values-grid{padding:24px 0}
  .value{padding:5px 13px}
  .value h3{font-size:15px}
  .value p{font-size:10px}
  .leader-grid{grid-template-columns:1fr;max-width:480px}
  .leader-card{padding:23px}
  .leader-img{width:100px;height:100px;flex-basis:100px}
  .cta-inner{align-items:flex-start;flex-direction:column}
  .footer-main{grid-template-columns:1fr 1fr;gap:28px}
  .footer-about{grid-column:1/-1}
}
@media(max-width:430px){
  .container{width:calc(100% - 28px)}
  .hero h1{font-size:39px}
  .hero-actions{align-items:stretch;flex-direction:column;max-width:280px}
  .hero-actions .btn{width:100%}
  .stats-grid{grid-template-columns:1fr;gap:0}
  .stat{padding:17px;border-right:0;border-bottom:1px solid #e8dfce}
  .stat:last-child{border-bottom:0}
  .value{padding:5px 8px}
  .value-icon{font-size:22px}
  .value h3{font-size:12px}
  .value p{font-size:9px}
  .mv-card{padding:30px 24px}
  .leader-card{gap:14px;padding:17px}
  .leader-img{width:80px;height:80px;flex-basis:80px}
  .leader-card h3{font-size:16px}
  .footer-main{grid-template-columns:1fr}
  .footer-about{grid-column:auto}
  .copyright{flex-direction:column}
}
</style>
</head>

